# ── 텔레그램 (Phase 0-2) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 티스토리 (Phase 3) ─────────────────────────────────
TISTORY_BLOG_URL=https://example.tistory.com
TISTORY_BLOG_NAME=example

# ── Google (Phase 4) ──────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/gcp-service-account.json
GA4_PROPERTY_ID=
GSC_SITE_URL=https://example.tistory.com/
ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_SECRET=
ADSENSE_REFRESH_TOKEN=
ADSENSE_ACCOUNT_ID=

# ── 운영 ──────────────────────────────────────────────
TZ=Asia/Seoul
LOG_LEVEL=info
# 발행 전 텔레그램 승인 필수 여부. false 로 두지 마세요 (애드센스 정책 리스크)
REQUIRE_APPROVAL=true
# 주당 발행 목표
POSTS_PER_WEEK=3
